# OpenAI-compatible endpoint and model ID for the legacy generator.
LLM_BASE_URL=
LLM_MODEL=

# Optional when the endpoint accepts unauthenticated requests.
LLM_API_KEY=

# SQLite file location. Default is ./data/planner.db.
DATABASE_PATH=./data/planner.db

# The legacy generator interviews you and produces five documents.
# It is disabled by default. Set the exact value "1" to enable /legacy,
# /api/projects, and /api/docs.
# ENABLE_LEGACY_GENERATOR=1
