# Endpoint OpenAI-compatible. Default memakai proxy lokal.
LLM_BASE_URL=http://127.0.0.1:17070/v1
LLM_MODEL=deepseek-v4.1-flash-free

# Kosongkan kalau proxy tidak butuh autentikasi.
LLM_API_KEY=

# Lokasi file SQLite. Default: ./data/planner.db
DATABASE_PATH=./data/planner.db

# Generator 5-dokumen lama (idea -> interview -> 5 dokumen via LLM).
# Mati secara default. Setel persis "1" (nilai lain tidak berlaku) untuk mengaktifkan halaman /legacy dan rute /api/projects, /api/docs.
# ENABLE_LEGACY_GENERATOR=1   (hanya nilai persis "1" yang mengaktifkan; nilai lain = mati)
